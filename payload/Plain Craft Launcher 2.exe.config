<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      仅仅添加 appDomainManager* 会让 CLR 退回旧式路径处理（UseLegacyPathHandling=True、
      BlockLongPaths=True），于是 PCL 的 PathUtils.ForApi() 生成的 "\\?\" 长路径全部失效，
      File.Exists / File.WriteAllText 会抛 "Illegal characters in path"，
      启动时 CheckPermissionWithException 失败 → 弹出"没有对当前文件夹的权限"。
      显式关掉这两个开关即可恢复原始行为。
    -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
    <appDomainManagerAssembly value="PclRuntime, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="PclRuntime.PclRuntimeManager" />
  </runtime>
</configuration>
